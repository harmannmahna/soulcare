{
  "Cloudinary.cloudinary": {
    "version": "v1",
    "sandbox_endpoint": "http://localhost",
    "production_endpoint": "https://api.cloudinary.com",
    "methods": 47,
    "auth": {
      "provider_slug": "Cloudinary",
      "type": "basic_auth"
    },
    "init_details": {
      "VERSION": "2.0.2",
      "auth_type": "basic_auth"
    },
    "execution_policy": {
      "max_retries": 3,
      "base_delay_ms": 500,
      "max_delay_ms": 30000,
      "http_timeout_ms": 30000,
      "connect_timeout_ms": 5000,
      "total_timeout_ms": 90000,
      "retry_on": [
        429,
        503,
        504
      ],
      "non_retryable": [
        400,
        401,
        403,
        404,
        422
      ],
      "on_401": "fail",
      "max_concurrent": 5,
      "max_response_bytes": 102400,
      "idempotency": {
        "mode": "none",
        "header_name": "Idempotency-Key",
        "scope": "call"
      }
    }
  },
