# SoulCare API — copy to .env and fill in. Never commit secrets.
DEMO_MODE=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=soulcare
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=soulcare-admin-demo
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-2.0-flash-lite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
RATE_LIMIT_PER_MIN=30

# Hybrid risk classifier (sklearn artifact by default; Qwen LoRA adapter optional)
RISK_MODEL_PATH=

# Therapist vector search (falls back to local TF-IDF if unset)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Red-tier NGO notify — first matching channel wins; else logs to admin ngo_inbox
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NGO_ALERT_EMAIL=

# Optional Swytchcode extras
YOUTUBE_API_KEY=
CLOUDINARY_URL=
FIRECRAWL_API_KEY=
