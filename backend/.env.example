# SoulCare API — copy to .env and fill in. Never commit secrets.
DEMO_MODE=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=soulcare
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=soulcare-admin-demo
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-2.0-flash-lite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
RATE_LIMIT_PER_MIN=30

# Hybrid risk classifier (sklearn artifact by default; LoRA adapter folder optional)
RISK_MODEL_PATH=
# HF_TOKEN=   # only for Colab Qwen download if gated — do not commit

# Swytchcode kernel — all Slack/Weaviate/Firecrawl/YouTube/Calendar/Cloudinary calls
# Default true: always `swytchcode exec --demo`. Set false for a live pitch once keys exist.
SWYTCHCODE_DEMO=true
SWYTCHCODE_BIN=
# SWYTCHCODE_TIMEOUT=12

# Therapist vector search via Swytchcode Weaviate GraphQL (local TF-IDF if unset / demo)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Red-tier NGO notify — Swytchcode Slack bot (not an incoming webhook)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional leftover webhook (not the Swytchcode path)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NGO_ALERT_EMAIL=

# Optional Swytchcode extras
YOUTUBE_API_KEY=
CLOUDINARY_URL=
FIRECRAWL_API_KEY=
GOOGLE_CALENDAR_TOKEN=

# Live avatar companion (Talk to Companion) — never commit real keys
HUME_API_KEY=
HUME_SECRET_KEY=
D_ID_API_KEY=
D_ID_PRESENTER_URL=https://d-id-public-bucket.s3.amazonaws.com/or-roman.jpg
